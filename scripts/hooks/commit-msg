#!/usr/bin/env bash
# libcrippy — enforce Conventional Commits.
#
# CI re-checks this authoritatively; this hook just fails fast locally.
# Bypass: git commit --no-verify   (or LEFTHOOK=0)
set -euo pipefail

msg_file="${1:?commit-msg: expected a message file path}"

# First non-blank, non-comment line.
subject="$(grep -v '^#' "$msg_file" | sed '/[^[:space:]]/,$!d' | head -n1)"

# Git-generated subjects we do not control.
case "$subject" in
  "Merge "*|"Revert "*|fixup!*|squash!*|"Applying "*) exit 0 ;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'

if ! printf '%s' "$subject" | grep -Eq "^(${types})(\([a-z0-9._/-]+\))?!?: .+"; then
  cat >&2 <<MSG
commit-msg: subject is not a Conventional Commit.

  got:      ${subject}
  expected: <type>[(scope)][!]: <description>
  types:    ${types//|/, }

  examples:
    feat(client): verify crippy's signing certificate before binding
    fix(contract)!: page directory listings rather than returning them whole
    docs: record the transaction-code rule in AGENTS.md

  A '!' before the colon, or a 'BREAKING CHANGE:' footer, marks a breaking change.
MSG
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  printf 'commit-msg: subject is %d chars; keep it <= 72.\n  %s\n' "${#subject}" "$subject" >&2
  exit 1
fi

exit 0
