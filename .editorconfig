root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 120
ktlint_code_style = ktlint_official

[*.{yml,yaml,toml,json}]
indent_size = 2
indent_style = space

[*.xml]
indent_size = 4
indent_style = space
